{
    "manifest_version": 1,
    "id": "com.bwat47.joplin-enhanced-rendering",
    "app_min_version": "3.7",
    "version": "0.5.1",
    "platforms": ["desktop", "mobile"],
    "name": "Enhanced Rendering",
    "description": "Render Mermaid diagrams and KaTeX math directly in Joplin's Markdown editor",
    "author": "bwat47",
    "homepage_url": "https://github.com/bwat47/joplin-enhanced-rendering",
    "repository_url": "https://github.com/bwat47/joplin-enhanced-rendering",
