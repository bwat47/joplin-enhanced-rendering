        { "src": "images/mermaid-editing.png", "label": "Mermaid editing with preview" },
        { "src": "images/mermaid-fullscreen.png", "label": "Mermaid fullscreen dialog" },
        { "src": "images/math.png", "label": "Math rendering" }
    ],
    "promo_tile": {
        "src": "images/promo_tile.png",
        "label": "Enhanced Rendering Promo Tile"
    }
