{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": [
        "src/contentScript/enhancedRendering.ts",
        "src/fullscreenDialog/panZoom.ts",
        "src/fullscreenDialog/exportMenu.ts",
        "src/fullscreenDialog/styles.css"
    ],
    "supportEntry": ["src/**/*.test.ts", "src/contentScript/testing/**/*.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**", "src/logger.ts"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off",
        "test-only-exports": "warn",
        "require-suppression-reason": "error"
    },
    "health": {
        "ignore": ["src/**/*.test.ts", "src/contentScript/testing/**/*.ts"],
        "maxCognitive": 15,
        "maxCyclomatic": 20
    }
}
